<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage1.master.cs" Inherits="WebsiteReworkMasterPages.MasterPages.MasterPage1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
